  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\uB9E4\uAC70\uC9C4 <\uB5A0\uC624\uB974\uB294 New star!> \n\uB9C8\uC57C\uC758
    \uC778\uD130\uBDF0 \uC911 \u2026 \n\nQ : \uBB34\uBA85 \uC2DC\uC808\uC774 \uAF64
    \uAE34 \uAC78\uB85C \uC54C\uACE0 \uC788\uC5B4\uC694 \n\uC9C0\uAE08 \uAE30\uBD84\uC774
    \uC5B4\uB5A0\uC2E0\uAC00\uC694? \nA: \uC774\uB807\uAC8C \uB5A0\uC624\uB974\uB294
    New star \uB9E4\uAC70\uC9C4\uC5D0 \uC778\uD130\uBDF0\uB97C \n\uD558\uACE0 \uC788\uB2E4\uB294
    \uC0AC\uC2E4\uC774 \uB108\uBB34 \uAE30\uBED0\uC694 \n\uC9C0\uAE08 \uC774 \uC21C\uAC04\uC774
    \uB108\uBB34 \uAFC8\uB9CC \uAC19\uC544\uC694 \n\nQ : \uC9C0\uAE08 \uAC00\uC7A5
    \uC0DD\uAC01\uB098\uB294 \uC0AC\uB78C\uC774 \uB204\uAD6C\uC2E0\uAC00\uC694? \nA
    : \uC800\uC758 \uAC00\uC7A5 \uC18C\uC911\uD55C \uCE5C\uAD6C Hazel\uACFC Leo\uAC00
    \uC0DD\uAC01\uB098\uB124\uC694 \n\nQ : \uD558\uD558, \uCE5C\uAD6C \uBD84\uB4E4\uC774
    \uC0DD\uAC01\uB098\uB294 \uC774\uC720\uAC00 \uC788\uC73C\uC2E4\uAE4C\uC694? \nA
    : Hazel\uC740 \uC81C \uAC00\uC7A5 \uC624\uB79C \uCE5C\uAD6C\uACE0 \uC81C \uAFC8\uC744
    \uD56D\uC0C1 \uC751\uC6D0\uD574\uC92C\uC5B4\uC694 \nLeo\uB294 \uCD5C\uADFC\uC5D0
    \uC54C\uAC8C \uB418\uC5C8\uB294\uB370 \uB300\uD654\uB3C4 \uB108\uBB34 \uC798
    \uD1B5\uD558\uACE0 \n\uCC38 \uBA4B\uC9C4 \uB0A8\uC790\uC5D0\uC694 Hazel\uC774
    \uBD80\uB7FD\uB124\uC694"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8e543065568168b45bbd90d22f8135b3, type: 2}
